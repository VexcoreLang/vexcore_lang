{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "PenLang",
  "scopeName": "source.penlang",
  "patterns": [
    { "include": "#comments" },
    { "include": "#sections" },
    { "include": "#keywords" },
    { "include": "#booleansAndNull" },
    { "include": "#numbers" },
    { "include": "#fstrings" },
    { "include": "#strings" },
    { "include": "#operators" },
    { "include": "#moduleCall" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.penlang",
          "match": "#.*$"
        }
      ]
    },
    "sections": {
      "patterns": [
        {
          "name": "entity.name.section.penlang",
          "match": "\\[(setts|scenary)\\]"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.penlang",
          "match": "\\b(let|if|elf|els|while|for|in|run|log|fn|return|use)\\b"
        }
      ]
    },
    "booleansAndNull": {
      "patterns": [
        {
          "name": "constant.language.penlang",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.penlang",
          "match": "\\b\\d+(?:\\.\\d+)?\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.penlang",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.penlang",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.penlang",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.penlang",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "fstrings": {
      "patterns": [
        {
          "name": "string.interpolated.penlang",
          "begin": "f(\"|')",
          "beginCaptures": {
            "0": { "name": "keyword.other.fstring.penlang" }
          },
          "end": "\\1",
          "patterns": [
            {
              "name": "meta.interpolation.penlang",
              "match": "\\{[^}]+\\}"
            },
            {
              "name": "constant.character.escape.penlang",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.penlang",
          "match": "\\+\\=|\\-\\=|\\*\\=|\\/\\=|\\|\\||&&|==|!=|<=|>=|\\*\\*|\\/\\/|\\.\\.|[+\\-*/%<>=!]"
        }
      ]
    },
    "moduleCall": {
      "patterns": [
        {
          "name": "meta.module-call.penlang",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\.([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "entity.name.namespace.penlang" },
            "2": { "name": "entity.name.function.penlang" }
          }
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.penlang",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    }
  }
}
