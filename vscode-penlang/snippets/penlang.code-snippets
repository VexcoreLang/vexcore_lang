{
  "VCL File Template": {
    "prefix": "vclfile",
    "body": [
      "[setts]",
      "cpu=${1:1};",
      "ram=${2:1024};",
      "mem=${3:0};",
      "",
      "[scenary]",
      "",
      "$0"
    ],
    "description": "Basic VCL file template"
  },
  "Use Import": {
    "prefix": "usevcl",
    "body": [
      "use \"${1:lib}.vcl\";"
    ],
    "description": "Import another VCL file"
  },
  "Typed Let": {
    "prefix": "lett",
    "body": [
      "let ${1:name}: ${2:int} = ${3:0};"
    ],
    "description": "Typed variable declaration"
  },
  "Function": {
    "prefix": "fnv",
    "body": [
      "fn ${1:name}(${2:a: int}, ${3:b: int}): ${4:int} {",
      "  ${5:return ${2/(.*):.*/$1/} + ${3/(.*):.*/$1/};}",
      "}"
    ],
    "description": "User function with typed params"
  },
  "If Elf Els": {
    "prefix": "ifv",
    "body": [
      "if (${1:condition}) {",
      "  ${2:log(\"ok\");}",
      "} elf (${3:otherCondition}) {",
      "  ${4:log(\"other\");}",
      "} els {",
      "  ${5:log(\"fallback\");}",
      "}"
    ],
    "description": "if / elf / els block"
  },
  "For Range": {
    "prefix": "forv",
    "body": [
      "for (${1:i} in ${2:1}..${3:10}) {",
      "  ${4:log(f\"${1:i} = {${1:i}}\");}",
      "}"
    ],
    "description": "for loop over range"
  },
  "Net Ping": {
    "prefix": "netping",
    "body": [
      "let ${1:ok}: bool = net.ping(\"${2:8.8.8.8}\");",
      "log(${1:ok});"
    ],
    "description": "Call net.ping from stdlib"
  }
}
